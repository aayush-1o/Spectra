# Spectra — Production Environment Template (Render / Cloud)
# This file documents what to set in your cloud platform's secret dashboard.
# DO NOT COMMIT THIS FILE WITH REAL VALUES.

# ── PostgreSQL (Render Internal Connection String) ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require

# ── Neo4j AuraDB ───────────────────────────────────────────────────────────────
# Get from: console.neo4j.io → your instance → Connect
NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<aura-generated-password>

# ── Redis (Upstash) ────────────────────────────────────────────────────────────
# Get from: console.upstash.com → your DB → Details → Connection String (Redis URL)
# NOTE: Upstash uses rediss:// (TLS), not redis://
REDIS_URL=rediss://default:<password>@<host>:<port>

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<64-char-hex-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false
ALLOW_DOCS=false

# ── CORS ───────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://spectra-simsight.vercel.app
# OR use the override to list multiple origins:
# CORS_ORIGINS_OVERRIDE=https://spectra-simsight.vercel.app,https://www.yourdomain.com
