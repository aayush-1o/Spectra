# Spectra — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
#
# For production, set these same variables in your cloud platform's
# environment / secrets dashboard (Render, Vercel, etc.).

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=postgresql+asyncpg://spectra:spectra@localhost:5432/spectra
# Render Postgres (production) format:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Neo4j ──────────────────────────────────────────────────────────────────────
# Local dev (Docker):
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=spectra123
# AuraDB (production) format:
# NEO4J_URI=neo4j+s://xxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<aura-generated-password>

# ── Redis ──────────────────────────────────────────────────────────────────────
# Local dev:
REDIS_URL=redis://localhost:6379
# Upstash (production) format:
# REDIS_URL=rediss://:password@host:6380

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate a strong key:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── App ────────────────────────────────────────────────────────────────────────
# Options: development | production
ENVIRONMENT=development

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# DEBUG: true enables SQLAlchemy echo + detailed error tracebacks
DEBUG=false

# ALLOW_DOCS: false hides /docs and /redoc (set false in production)
ALLOW_DOCS=true

# ── CORS ───────────────────────────────────────────────────────────────────────
# Set your deployed frontend URL so CORS allows it:
FRONTEND_URL=
# Advanced: override the full CORS list (comma-separated, takes precedence)
# CORS_ORIGINS_OVERRIDE=https://spectra.vercel.app,https://spectra.example.com

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# Local dev (proxied via Vite):
VITE_API_BASE_URL=http://localhost:8000
# Production (set in Vercel dashboard or frontend/.env.production):
# VITE_API_BASE_URL=https://spectra-api.onrender.com

# ── Phase 8: AI Integration ────────────────────────────────────────────────────
# Required for NL Search and AI Summary features (Anthropic Claude).
# Get your key from https://console.anthropic.com/settings/keys
# NEVER hardcode this value — always use this environment variable.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Google API ─────────────────────────────────────────────────────────────────
# Used for Google Maps, Geocoding, or Gemini AI features.
# Get your key from https://console.cloud.google.com/apis/credentials
# NEVER hardcode — always use this environment variable.
GOOGLE_API_KEY=your-google-api-key-here
